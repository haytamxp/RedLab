# Application
APP_NAME=RedLab
APP_VERSION=1.0.0
APP_ENV=development

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=redlab

# LDAP
LDAP_HOST=192.168.56.10
LDAP_PORT=389
LDAP_USERNAME=Administrator
LDAP_PASSWORD=Password123!
LDAP_BASE_DN=DC=redlab,DC=local
LDAP_USE_TLS=false

# JWT
JWT_SECRET=my_secret_key
JWT_EXPIRATION=24

# Logger
LOG_LEVEL=debug
LOG_FORMAT=console