# ==========================
# Application
# ==========================
APP_NAME=RedLab
APP_VERSION=1.0.0
APP_ENV=development

# ==========================
# Server
# ==========================
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_READ_TIMEOUT=15
SERVER_WRITE_TIMEOUT=15
SERVER_IDLE_TIMEOUT=60

# ==========================
# Database
# ==========================
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=redlab
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=300

# ==========================
# LDAP
# ==========================
LDAP_HOST=192.168.56.10
LDAP_PORT=389
LDAP_USERNAME=Administrator
LDAP_PASSWORD=Password123!
LDAP_BASE_DN=DC=redlab,DC=local
LDAP_USE_TLS=false

# ==========================
# JWT
# ==========================
JWT_SECRET=my_super_secret_key_change_me
JWT_EXPIRATION=24

# ==========================
# Logger
# ==========================
LOG_LEVEL=debug
LOG_FORMAT=console
LOG_OUTPUT=stdout
LOG_DEVELOPMENT=true